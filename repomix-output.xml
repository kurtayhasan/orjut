  environmentType, setEnvironmentType,
  selectedCountryCode, setSelectedCountryCode,
  selectedStateCode, setSelectedStateCode,
  city, setCity,
  district, setDistrict,
  neighborhood, setNeighborhood,
  blockNo, setBlockNo,
  parcelNo, setParcelNo,
  plotSize, sizeSqm,
